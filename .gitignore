# dependencies
node_modules/
.npm-cache/
.electron-cache/
.electron-builder-cache/
.local-appdata/
.runtime-appdata/
dist/

# environment and local machine files
.env
.env.*
!.env.example
local.properties

# Android build output and local caches
.android-build/
.android-user/
.gradle/
.gradle-motorista/
**/build/

# Android signing keys - never commit these
*.keystore
*.jks
key.properties
*key-passwords*.txt
*upload-key-passwords*.txt

# generated files and temporary outputs
outputs/
*.log
*.tmp
*.bak

# OS/editor files
.DS_Store
Thumbs.db

# credentials that must never reach the public repo
*service-account*.json
*serviceAccount*.json
*firebase-adminsdk*.json
google-services.json
*.pem
*.p12
*.pfx

# local browser profiles used in tests (cookies and logins)
.chrome-*/
.edge-*/
