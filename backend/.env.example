PORT=10000
APP_BASE_URL=https://nexusmotoja.com.br
BACKEND_BASE_URL=https://SEU-BACKEND.onrender.com
ALLOWED_ORIGINS=https://nexusmotoja.com.br,http://localhost:5173,http://localhost:8080,http://localhost:8093,http://127.0.0.1:8093
GEOAPIFY_API_KEY=cole-sua-chave-geoapify-no-render
ADMIN_API_KEY=troque-por-uma-chave-grande-e-unica
OWNER_PASSWORD=troque-por-uma-senha-forte-do-dono
DRIVER_PASSWORD=troque-por-uma-senha-forte-dos-motoboys
DATA_ENCRYPTION_KEY=gere-uma-chave-longa-aleatoria-e-exclusiva
CARDAPIOWEB_API_BASE_URL=https://integracao.cardapioweb.com/api/partner/v1

# Cole o JSON inteiro da conta de servico do Firebase em uma linha.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"moto-conchal"}

# Mercado Pago marketplace/OAuth.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=https://SEU-BACKEND.onrender.com/api/mercadopago/oauth/callback

# Token da sua conta Mercado Pago. Usado para consultar webhooks/pagamentos.
MP_OWNER_ACCESS_TOKEN=

DRIVER_PERCENT=0.70
APP_PERCENT=0.30
PENDING_EXPIRE_MINUTES=5
ACCEPTED_NOTICE_MINUTES=3

# Nexus CarroJa. Dia 06h-18h: R$ 4,20/km; noite 18h-00h: R$ 6,20/km;
# madrugada 00h-06h: R$ 8,20/km. O motorista recebe 80% por padrao.
CAR_RIDE_EXPIRE_MINUTES=8
CAR_DRIVER_PERCENT=0.80

# Telegram dos motoboys.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_AGUAI=
TELEGRAM_CHAT_ID_ENGENHEIRO_COELHO=
TELEGRAM_GROUP_LINK=https://t.me/seu-grupo-privado-dos-motoboys

# Envio de pedidos recebidos por mensagem para grupo WhatsApp via Evolution API.
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=nexus-motoja

# Cadastro progressivo dos clientes. Ative somente depois de testar o envio do codigo WhatsApp.
CUSTOMER_FREE_RIDES=3
CUSTOMER_REGISTRATION_ENFORCED=false
