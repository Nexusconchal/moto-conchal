{
  "appId": "br.com.nexusconchal.motoja.cliente",
  "appName": "MotoJá",
  "webDir": "www",
  "server": {
    "url": "https://nexusmotoja.com.br",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": ["nexusmotoja.com.br", "www.nexusmotoja.com.br", "nexusconchal.github.io"]
  },
  "ios": {
    "appendUserAgent": "MotoJaClienteiOS/1",
    "contentInset": "never",
    "backgroundColor": "#000000"
  },
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "packageOptions": {
          "@capacitor-firebase/messaging": {
            "symlink": true
          }
        }
      }
    }
  }
}
